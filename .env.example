# ============================================================================
# MIS Odoo Project - Environment Configuration Template
# ============================================================================
# Cách dùng:
# 1. Copy file này thành .env
# 2. Đổi toàn bộ mật khẩu CHANGE_ME_* trước khi chạy VPS hoặc push repo
# 3. KHÔNG commit file .env lên GitHub
# ============================================================================

# PostgreSQL
# POSTGRES_DB là database mặc định của PostgreSQL, không phải database nghiệp vụ Odoo.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Odoo
# ODOO_DB_NAME là database Odoo nhóm tạo ở màn hình Create Database.
ODOO_DB_NAME=mis_project
ODOO_MASTER_PASSWORD=CHANGE_ME_STRONG_ODOO_MASTER_PASSWORD
ODOO_PORT=8069

# Local/VPS public demo: 0.0.0.0
# Khi dùng Nginx reverse proxy: đổi thành 127.0.0.1
ODOO_BIND_IP=0.0.0.0

# Development mode:
# - Local code add-on: có thể bật --dev=all
# - VPS demo nhóm: nên để trống để ổn định hơn
ODOO_DEV_ARGS=
# ODOO_DEV_ARGS=--dev=all

# Backup scripts
DB_CONTAINER_NAME=mis_odoo_db
ODOO_CONTAINER_NAME=mis_odoo_web
BACKUP_DIR=backups
