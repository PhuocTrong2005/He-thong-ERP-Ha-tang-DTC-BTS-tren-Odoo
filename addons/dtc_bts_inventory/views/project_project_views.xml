<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_form_bts_inventory" model="ir.ui.view">
        <field name="name">project.project.form.bts.inventory</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="dtc_bts_base.view_dtc_bts_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_create_bts_material_request"
                    string="Tạo yêu cầu vật tư"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'approved'"
                    groups="dtc_bts_base.group_dtc_bts_ksgs,base.group_system"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_bts_material_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="bts_material_request_count == 0">
                    <field
                        name="bts_material_request_count"
                        widget="statinfo"
                        string="Yêu cầu vật tư"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
