<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dtc_bts_inventory_dashboard_form" model="ir.ui.view">
        <field name="name">dtc.bts.inventory.dashboard.form</field>
        <field name="model">dtc.bts.inventory.dashboard</field>
        <field name="arch" type="xml">
            <form
                string="Theo dõi cung ứng vật tư công trình"
                create="false"
                edit="false"
                delete="false">
                <sheet>
                    <field name="dashboard_html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtc_bts_inventory_dashboard" model="ir.actions.act_window">
        <field name="name">Theo dõi cung ứng vật tư</field>
        <field name="res_model">dtc.bts.inventory.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dtc_bts_inventory_dashboard_form"/>
        <field name="res_id" ref="inventory_dashboard_default"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

</odoo>
