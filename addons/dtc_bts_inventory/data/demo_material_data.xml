            <field name="standard_price">2800000</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
        </record>

        <record id="product_bts_splice_closure" model="product.template">
            <field name="name">Hộp nối quang</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product_category_bts_auxiliary"/>
