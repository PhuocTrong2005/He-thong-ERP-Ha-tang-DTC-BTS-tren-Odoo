<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_bts_fiber_cable" model="product.template">
            <field name="name">Cáp quang 24 core</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product_category_bts_cable"/>
            <field name="is_bts_material" eval="True"/>
            <field name="list_price">125000</field>
            <field name="standard_price">98000</field>
            <field name="uom_id" ref="uom.product_uom_meter"/>
