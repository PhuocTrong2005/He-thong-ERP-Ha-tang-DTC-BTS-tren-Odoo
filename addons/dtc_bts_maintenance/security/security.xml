<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="dtc_bts_base.group_dtc_bts_infrastructure" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
    </record>

    <record id="dtc_bts_base.group_dtc_bts_admin" model="res.groups">
        <field name="implied_ids"
               eval="[(3, ref('maintenance.group_equipment_manager'))]"/>
    </record>

    <record id="rule_maintenance_batch_enterprise_director" model="ir.rule">
        <field name="name">Phiếu bảo trì: phạm vi Giám đốc Xí nghiệp</field>
        <field name="model_id" ref="model_bts_maintenance_batch"/>
        <field name="groups" eval="[(4, ref('dtc_bts_base.group_bts_enterprise_director'))]"/>
        <field name="domain_force">[('project_id.enterprise_director_id', '=', user.id)]</field>
    </record>

    <record id="rule_maintenance_equipment_enterprise_director" model="ir.rule">
        <field name="name">Thiết bị bảo trì: phạm vi Giám đốc Xí nghiệp</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="groups" eval="[(4, ref('dtc_bts_base.group_bts_enterprise_director'))]"/>
        <field name="domain_force">[('bts_project_id.enterprise_director_id', '=', user.id)]</field>
    </record>

    <record id="rule_maintenance_request_enterprise_director" model="ir.rule">
        <field name="name">Yêu cầu bảo trì: phạm vi Giám đốc Xí nghiệp</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="groups" eval="[(4, ref('dtc_bts_base.group_bts_enterprise_director'))]"/>
        <field name="domain_force">[('bts_project_id.enterprise_director_id', '=', user.id)]</field>
    </record>

    <record id="rule_repair_proposal_enterprise_director" model="ir.rule">
        <field name="name">Đề xuất sửa chữa: phạm vi Giám đốc Xí nghiệp</field>
        <field name="model_id" ref="model_bts_repair_proposal"/>
        <field name="groups" eval="[(4, ref('dtc_bts_base.group_bts_enterprise_director'))]"/>
        <field name="domain_force">['|', ('project_id.enterprise_director_id', '=', user.id), ('bts_project_id.enterprise_director_id', '=', user.id)]</field>
    </record>

</odoo>
