<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bts_maintenance_checklist_result_tree" model="ir.ui.view">
        <field name="name">bts.maintenance.checklist.result.tree</field>
        <field name="model">bts.maintenance.checklist.result</field>
        <field name="arch" type="xml">
            <tree string="Kết quả checklist bảo trì" create="false">
                <field name="request_id"/>
                <field name="item_id"/>
                <field name="category_id"/>
                <field name="frequency_months"/>
                <field name="is_external_required"/>
                <field name="result_state"/>
                <field name="is_resolved"/>
                <field name="repair_proposal_id"/>
                <field name="resolved_date"/>
                <field name="measurement_value"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_bts_maintenance_checklist_result_form" model="ir.ui.view">
        <field name="name">bts.maintenance.checklist.result.form</field>
        <field name="model">bts.maintenance.checklist.result</field>
        <field name="arch" type="xml">
            <form string="Kết quả checklist bảo trì">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="item_id" readonly="1"/>
                            <field name="category_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="frequency_months" readonly="1"/>
                            <field name="is_external_required" readonly="1"/>
                            <field name="result_state"/>
                            <field name="is_resolved" readonly="1"/>
                            <field name="repair_proposal_id" readonly="1"/>
                            <field name="resolved_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="measurement_value"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bts_maintenance_checklist_result_search" model="ir.ui.view">
        <field name="name">bts.maintenance.checklist.result.search</field>
        <field name="model">bts.maintenance.checklist.result</field>
        <field name="arch" type="xml">
            <search string="Tìm kết quả checklist">
                <field name="request_id"/>
                <field name="item_id"/>
                <field name="category_id"/>
                <filter
                    name="need_repair"
                    string="Cần sửa chữa"
                    domain="[('result_state', '=', 'need_repair')]"/>
                <filter
                    name="need_replacement"
                    string="Cần thay thế"
                    domain="[('result_state', '=', 'need_replacement')]"/>
                <filter
                    name="unresolved_failure"
                    string="Lỗi chưa xử lý"
                    domain="[('result_state', 'in', ('need_repair', 'need_replacement')), ('is_resolved', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_request" string="Phiếu bảo trì" context="{'group_by': 'request_id'}"/>
                    <filter name="group_category" string="Loại trạm" context="{'group_by': 'category_id'}"/>
                    <filter name="group_result" string="Kết quả" context="{'group_by': 'result_state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
