<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mail_template_project_assignment" model="mail.template">
            <field name="name">Dự án - Phân công KSGS phụ trách</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="subject">[DTC BTS] Thông báo phân công dự án - {{ object.project_code }} - {{ object.display_name }}</field>
            <field name="email_from">{{ ctx.get('sender_email') or user.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;color:#1f2937;max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #bfdbfe;border-top:8px solid #0b5ed7;border-radius:10px;padding:26px">
                    <p style="margin:0 0 8px;color:#0b5ed7;font-size:13px;font-weight:bold;letter-spacing:.6px">HỆ THỐNG QUẢN LÝ DỰ ÁN BTS</p>
                    <h1 style="margin:0 0 24px;color:#0b5ed7;font-size:26px;line-height:1.3;font-weight:700">Thông báo phân công dự án</h1>
                    <p>Kính gửi <strong><t t-out="ctx.get('recipient_name') or 'Anh/Chị'"/></strong>,</p>
                    <p>Hệ thống trân trọng thông báo Anh/Chị đã được phân công phụ trách dự án BTS dưới đây:</p>
                    <table style="border-collapse:collapse;width:100%;margin:18px 0">
                        <tr><td style="width:32%;padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Mã dự án</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.project_code"/></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Tên dự án</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.display_name"/></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Loại trạm</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-if="object.station_type == 'macro'">Trạm Macro</t><t t-if="object.station_type == 'cell'">Trạm Cell</t></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Tỉnh/Thành phố</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.province or 'Chưa cập nhật'"/></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Quận/Huyện - Xã/Phường</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.district or 'Chưa cập nhật'"/> - <t t-out="object.commune or 'Chưa cập nhật'"/></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Thời gian dự kiến</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.planned_start_date or 'Chưa cập nhật'"/> - <t t-out="object.planned_end_date or 'Chưa cập nhật'"/></td></tr>
                        <tr><td style="padding:9px;background:#f3f6f8;border:1px solid #d8e0e5"><strong>Giám đốc Xí nghiệp</strong></td><td style="padding:9px;border:1px solid #d8e0e5"><t t-out="object.enterprise_director_id.display_name or 'Chưa cập nhật'"/></td></tr>
                    </table>
                    <p>Đề nghị Anh/Chị truy cập hệ thống để kiểm tra hồ sơ và triển khai công việc theo quy trình.</p>
                    <p t-if="ctx.get('record_url')" style="margin:24px 0">
                        <a t-att-href="ctx.get('record_url')" style="background:#1f5f78;color:#fff;padding:11px 18px;text-decoration:none;border-radius:4px;font-weight:bold">Truy cập dự án</a>
                    </p>
                    <p style="border-top:1px solid #d8e0e5;padding-top:16px;color:#6b7780;font-size:12px">Đây là thư được gửi tự động từ Hệ thống Quản lý Dự án BTS. Vui lòng không trả lời email này và không chia sẻ thông tin đăng nhập.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
