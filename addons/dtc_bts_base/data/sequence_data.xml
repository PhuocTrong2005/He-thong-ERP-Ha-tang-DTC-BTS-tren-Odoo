<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_dtc_bts_project" model="ir.sequence">
            <field name="name">Mã dự án BTS</field>
            <field name="code">dtc.bts.project</field>
            <field name="prefix">BTS-DA-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dtc_bts_station" model="ir.sequence">
            <field name="name">Mã trạm BTS</field>
            <field name="code">dtc.bts.station</field>
            <field name="prefix">BTS-TRAM-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
