<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dtc_bts_station_kanban" model="ir.ui.view">
        <field name="name">dtc.bts.station.kanban</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="station_code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="site_address"/>
                <field name="station_state"/>
                <field name="assigned_user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <strong>
                                <field name="station_code"/>
                            </strong>
                            <div>
                                <field name="name"/>
                            </div>
                            <div>Dự án: <field name="project_id"/></div>
                            <div>Địa chỉ: <field name="site_address"/></div>
                            <div>Trạng thái trạm: <field name="station_state"/></div>
                            <div>KSGS phụ trách: <field name="assigned_user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dtc_bts_station_tree" model="ir.ui.view">
        <field name="name">dtc.bts.station.tree</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <tree string="Danh sách trạm BTS">
                <field name="company_id" invisible="1"/>
                <field name="station_code"/>
                <field name="name" string="Tiêu đề"/>
                <field name="project_id"/>
                <field name="site_address"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="station_state"/>
                <field name="assigned_user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_dtc_bts_dashboard_graph" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.graph</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="Biểu đồ tổng hợp trạm BTS" type="bar" sample="1">
                <field name="station_state"/>
                <field name="project_id"/>
                <field name="handover_state"/>
                <field name="project_station_type"/>
                <field name="project_province"/>
                <field name="project_district"/>
            </graph>
        </field>
    </record>

    <record id="view_dtc_bts_dashboard_pivot" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Bảng phân tích trạm BTS" display_quantity="1" sample="1">
                <field name="project_id" type="row"/>
                <field name="station_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_dtc_bts_dashboard_kanban" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.kanban</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="station_state" create="false" class="o_kanban_dashboard">
                <field name="station_code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="project_station_type"/>
                <field name="project_province"/>
                <field name="project_district"/>
                <field name="station_state"/>
                <field name="handover_state"/>
                <field name="assigned_user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="station_code"/>
                                    </strong>
                                    <div>
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="mt8">
                                <div>Dự án: <field name="project_id"/></div>
                                <div>Loại trạm: <field name="project_station_type"/></div>
                                <div>Tỉnh/Thành phố: <field name="project_province"/></div>
                                <div>Quận/Huyện: <field name="project_district"/></div>
                                <div>Bàn giao: <field name="handover_state"/></div>
                                <div>KSGS phụ trách: <field name="assigned_user_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dtc_bts_dashboard_tree" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.tree</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <tree string="Danh sách báo cáo trạm BTS" create="false">
                <field name="station_code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="project_station_type"/>
                <field name="project_province"/>
                <field name="project_district"/>
                <field name="station_state"/>
                <field name="handover_state"/>
                <field name="acceptance_date"/>
                <field name="assigned_user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_dtc_bts_dashboard_search" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.search</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Báo cáo trạm BTS">
                <field name="name" string="Tên trạm BTS"/>
                <field name="station_code"/>
                <field name="project_id"/>
                <field name="station_state"/>
                <field name="handover_state"/>
                <field name="project_station_type"/>
                <field name="project_province"/>
                <field name="project_district"/>
                <filter name="handover_done" string="Trạm đã bàn giao" domain="[('handover_state', 'in', ['handed', 'accepted'])]"/>
                <filter name="handover_not_done" string="Trạm chưa bàn giao" domain="[('handover_state', 'in', ['not_handed', 'ready_to_handover'])]"/>
                <separator/>
                <filter name="group_project" string="Theo dự án" context="{'group_by': 'project_id'}"/>
                <filter name="group_station_state" string="Theo trạng thái trạm" context="{'group_by': 'station_state'}"/>
                <filter name="group_handover_state" string="Theo trạng thái bàn giao" context="{'group_by': 'handover_state'}"/>
                <filter name="group_station_type" string="Theo loại trạm" context="{'group_by': 'project_station_type'}"/>
                <filter name="group_province" string="Theo tỉnh" context="{'group_by': 'project_province'}"/>
                <filter name="group_district" string="Theo huyện" context="{'group_by': 'project_district'}"/>
            </search>
        </field>
    </record>

    <record id="view_dtc_bts_station_form" model="ir.ui.view">
        <field name="name">dtc.bts.station.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Tên trạm BTS</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='extra_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="dtc_bts_station_info" string="Thông tin trạm BTS">
                    <group>
                        <group>
                            <field name="station_code"/>
                            <field name="project_id" string="Dự án"/>
                            <field name="station_state"/>
                            <field name="acceptance_date"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="site_address"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_dtc_bts_dashboard" model="ir.actions.act_window">
        <field name="name">Bảng tổng hợp</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">graph,pivot,kanban,tree,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="view_dtc_bts_dashboard_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có dữ liệu trạm BTS để tổng hợp.
            </p>
            <p>
                Tạo trạm BTS từ menu Danh sách trạm BTS, sau đó quay lại Bảng tổng hợp để xem biểu đồ và bảng phân tích.
            </p>
        </field>
    </record>

    <record id="action_dtc_bts_dashboard_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_dtc_bts_dashboard_graph"/>
        <field name="act_window_id" ref="action_dtc_bts_dashboard"/>
    </record>

    <record id="action_dtc_bts_dashboard_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_dtc_bts_dashboard_pivot"/>
        <field name="act_window_id" ref="action_dtc_bts_dashboard"/>
    </record>

    <record id="action_dtc_bts_dashboard_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_dtc_bts_dashboard_kanban"/>
        <field name="act_window_id" ref="action_dtc_bts_dashboard"/>
    </record>

    <record id="action_dtc_bts_dashboard_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_dtc_bts_dashboard_tree"/>
        <field name="act_window_id" ref="action_dtc_bts_dashboard"/>
    </record>

    <record id="action_dtc_bts_dashboard_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dtc_bts_station_form"/>
        <field name="act_window_id" ref="action_dtc_bts_dashboard"/>
    </record>

    <record id="action_dtc_bts_station" model="ir.actions.act_window">
        <field name="name">Danh sách trạm BTS</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id" ref="view_dtc_bts_station_tree"/>
        <field name="context">{}</field>
    </record>

</odoo>
