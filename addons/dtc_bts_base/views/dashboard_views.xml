<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dtc_bts_dashboard_form" model="ir.ui.view">
        <field name="name">dtc.bts.dashboard.form</field>
        <field name="model">dtc.bts.dashboard</field>
        <field name="arch" type="xml">
            <form string="Bảng tổng hợp dự án BTS" create="false" edit="false" delete="false" class="o_dtc_bts_dashboard_form">
                <field name="dashboard_html" nolabel="1" readonly="1"/>
            </form>
        </field>
    </record>

    <delete id="action_dtc_bts_dashboard_graph" model="ir.actions.act_window.view"/>
    <delete id="action_dtc_bts_dashboard_pivot" model="ir.actions.act_window.view"/>
    <delete id="action_dtc_bts_dashboard_kanban" model="ir.actions.act_window.view"/>
    <delete id="action_dtc_bts_dashboard_tree" model="ir.actions.act_window.view"/>
    <delete id="action_dtc_bts_dashboard_form" model="ir.actions.act_window.view"/>

    <record id="action_dtc_bts_dashboard" model="ir.actions.act_window">
        <field name="name">Bảng tổng hợp</field>
        <field name="res_model">dtc.bts.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dtc_bts_dashboard_form"/>
        <field name="search_view_id" eval="False"/>
        <field name="res_id" ref="dtc_bts_dashboard_main"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

</odoo>
