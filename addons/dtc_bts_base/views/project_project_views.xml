<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_dtc_bts_project_kanban" model="ir.ui.view">
        <field name="name">dtc.bts.project.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="project_code"/>
                <field name="name"/>
                <field name="station_type"/>
                <field name="telecom_partner_id"/>
                <field name="province"/>
                <field name="district"/>
                <field name="commune"/>
                <field name="state"/>
                <field name="station_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="project_code"/>
                                    </strong>
                                    <div>
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="mt8">
                                <div>Loại trạm: <field name="station_type"/></div>
                                <div>Đối tác viễn thông: <field name="telecom_partner_id"/></div>
                                <div>
                                    Khu vực:
                                    <field name="province"/>
                                    <t t-if="record.district.raw_value"> / <field name="district"/></t>
                                    <t t-if="record.commune.raw_value"> / <field name="commune"/></t>
                                </div>
                                <div>Trạng thái: <field name="state"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt8">
                                <div class="oe_kanban_bottom_left">
                                    <span>Số lượng trạm: </span>
                                    <field name="station_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dtc_bts_project_tree" model="ir.ui.view">
        <field name="name">dtc.bts.project.tree</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Danh sách dự án BTS">
                <field name="project_code"/>
                <field name="name"/>
                <field name="station_type"/>
                <field name="telecom_partner_id"/>
                <field name="province"/>
                <field name="district"/>
                <field name="commune"/>
                <field name="project_manager_id"/>
                <field name="enterprise_director_id"
                       groups="dtc_bts_base.group_bts_enterprise_director,base.group_system"/>
                <field name="state"/>
                <field name="station_count"/>
            </tree>
        </field>
    </record>

    <record id="view_dtc_bts_project_form" model="ir.ui.view">
        <field name="name">dtc.bts.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Tên dự án BTS</attribute>
                <attribute name="placeholder">Nhập tên dự án BTS...</attribute>
            </xpath>
            <xpath expr="//div[@class='oe_title']/h1" position="before">
                <label for="name" string="Tên dự án BTS"/>
            </xpath>
            <xpath expr="//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page name="dtc_bts_project_info" string="Thông tin dự án BTS">
                    <group>
                        <group>
                            <field name="project_code"/>
                            <field name="station_type"/>
                            <field name="telecom_partner_id"/>
                            <field name="enterprise_director_id"
                                   groups="dtc_bts_base.group_bts_enterprise_director,base.group_system"/>
                            <field name="enterprise_director_id" readonly="1"
                                   groups="dtc_bts_base.group_dtc_bts_ksgs,!dtc_bts_base.group_bts_enterprise_director,!base.group_system"/>
                            <field name="project_manager_id"
                                   groups="dtc_bts_base.group_bts_enterprise_director,base.group_system"/>
                            <field name="project_manager_id" readonly="1"
                                   groups="dtc_bts_base.group_dtc_bts_ksgs,!dtc_bts_base.group_bts_enterprise_director,!base.group_system"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="province"/>
                            <field name="district"/>
                            <field name="commune"/>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                            <field name="acceptance_date"/>
                        </group>
                    </group>
                </page>
                <page name="dtc_bts_project_stations" string="Danh sách trạm thuộc dự án">
                    <button name="action_open_new_station"
                            type="object"
                            string="Thêm trạm"
                            icon="fa-plus"
                            class="btn-primary mb-2"
                            groups="dtc_bts_base.group_dtc_bts_ksgs,dtc_bts_base.group_bts_enterprise_director,base.group_system"/>
                    <field name="task_ids" context="{'default_project_id': id}">
                        <tree string="Trạm BTS" open_form_view="True">
                            <field name="station_code"/>
                            <field name="name"/>
                            <field name="site_address"/>
                            <field name="station_state"/>
                            <field name="assigned_user_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_dtc_bts_dashboard" model="ir.actions.act_window">
        <field name="name">Bảng tổng hợp</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">graph,pivot,kanban,tree,form</field>
        <field name="view_id" eval="False"/>
        <field name="context">{}</field>
    </record>

    <record id="action_dtc_bts_project" model="ir.actions.act_window">
        <field name="name">Danh sách dự án</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id" ref="view_dtc_bts_project_tree"/>
        <field name="context">{}</field>
    </record>

</odoo>
