<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_refresh_contract_overview" model="ir.cron">
        <field name="name">Hợp đồng BTS: cập nhật tổng hợp đến hạn</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_contract_overview()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_check_contract_expiry" model="ir.cron">
        <field name="name">Hợp đồng BTS: nhắc hạn và cập nhật hết hạn</field>
        <field name="model_id" ref="model_bts_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_contract_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_expire_signature_otps" model="ir.cron">
        <field name="name">Hợp đồng BTS: tự động hết hạn OTP ký số</field>
        <field name="model_id"
               ref="model_bts_contract_signature_batch_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_signature_otps()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
