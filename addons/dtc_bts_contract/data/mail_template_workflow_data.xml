        <record id="mail_template_renewal_failure_escalated" model="mail.template">
            <field name="name">Gia hạn - Giám đốc Xí nghiệp trình BGĐ</field>
            <field name="model_id" ref="model_bts_contract_renewal"/>
            <field name="subject">[DTC BTS] Đề nghị xem xét hủy dự án do không thể gia hạn - {{ object.project_id.display_name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;color:#1f2937;max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #bfdbfe;border-top:8px solid #0b5ed7;border-radius:10px;padding:26px">
                    <h1 style="margin:0 0 24px;color:#0b5ed7;font-size:26px;line-height:1.3;font-weight:700">Đề nghị quyết định do không thể gia hạn</h1>
                    <p>Kính gửi <strong><t t-out="ctx.get('recipient_name') or 'Anh/Chị'"/></strong>,</p>
                    <p>Giám đốc Xí nghiệp kính trình Ban Giám đốc xem xét trường hợp không thể gia hạn hợp đồng.</p>
