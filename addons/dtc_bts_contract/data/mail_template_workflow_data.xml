                    <p t-if="ctx.get('record_url')"><a t-att-href="ctx.get('record_url')" style="background:#714b67;color:#fff;padding:10px 16px;text-decoration:none;border-radius:4px">Mở hồ sơ và chấp thuận</a></p>
                </div>
            </field>
        </record>

        <record id="mail_template_renewal_project_station_cancelled" model="mail.template">
            <field name="name">Gia hạn - BGĐ quyết định hủy trạm/dự án</field>
            <field name="model_id" ref="model_bts_contract_renewal"/>
            <field name="subject">[DTC BTS] Thông báo quyết định {{ ctx.get('decision_label') }} - {{ object.renewal_code }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;color:#1f2937;max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #bfdbfe;border-top:8px solid #0b5ed7;border-radius:10px;padding:26px">
                    <h1 style="margin:0 0 24px;color:#0b5ed7;font-size:26px;line-height:1.3;font-weight:700">Quyết định sau khi không thể gia hạn</h1>
                    <p>Kính gửi <strong><t t-out="ctx.get('recipient_name') or 'Anh/Chị'"/></strong>,</p>
                    <p>Hệ thống trân trọng thông báo quyết định xử lý sau báo cáo không thể gia hạn hợp đồng.</p>
                    <p><strong>Quyết định:</strong> <t t-out="ctx.get('decision_label')"/></p>
                    <p><strong>Mã gia hạn / Hợp đồng:</strong> <t t-out="object.renewal_code"/> / <t t-out="object.contract_id.contract_code"/></p>
                    <p><strong>Dự án / Trạm:</strong> <t t-out="object.project_id.display_name"/> / <t t-out="object.station_id.display_name"/></p>
                    <p><strong>Người quyết định / Thời gian:</strong> <t t-out="object.decision_by_id.display_name"/> / <t t-out="format_datetime(object.decision_at)"/></p>
                    <p><strong>Lý do:</strong> <t t-out="object.decision_reason"/></p>
                    <p t-if="ctx.get('record_url')"><a t-att-href="ctx.get('record_url')">Mở hồ sơ gia hạn trong Odoo</a></p>
                </div>
            </field>
        </record>

        <record id="mail_template_contract_renewal_due_digest" model="mail.template">
            <field name="name">Hợp đồng - Digest nhắc gia hạn</field>
            <field name="model_id" ref="model_bts_contract"/>
            <field name="subject">[DTC BTS] Danh sách hợp đồng sắp hết hạn cần xử lý gia hạn</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;color:#1f2937;max-width:760px;margin:0 auto;background:#ffffff;border:1px solid #bfdbfe;border-top:8px solid #0b5ed7;border-radius:10px;padding:26px">
                    <p style="margin:0 0 8px;color:#0b5ed7;font-size:13px;font-weight:bold;letter-spacing:.6px">HỆ THỐNG QUẢN LÝ HỢP ĐỒNG BTS</p>
                    <h1 style="margin:0 0 24px;color:#0b5ed7;font-size:26px;line-height:1.3;font-weight:700">Danh sách hợp đồng sắp hết hạn</h1>
                    <p>Kính gửi <strong><t t-out="ctx.get('recipient_name') or 'Anh/Chị'"/></strong>,</p>
                    <p>Hệ thống kính gửi danh sách hợp đồng thuộc phạm vi phụ trách đang sắp hết hạn để Tổ hạ tầng theo dõi và triển khai thủ tục gia hạn.</p>
                    <p><strong>Ngày báo cáo:</strong> <t t-out="ctx.get('report_date')"/> · <strong>Số dự án:</strong> <t t-out="ctx.get('project_count')"/> · <strong>Số hợp đồng:</strong> <t t-out="ctx.get('contract_count')"/></p>
                    <t t-foreach="ctx.get('digest_projects') or []" t-as="project">
                        <h3><t t-out="project.get('name')"/> <t t-if="project.get('code')">(<t t-out="project.get('code')"/>)</t></h3>
                        <p t-if="project.get('responsible')"><strong>Người phụ trách Project:</strong> <t t-out="project.get('responsible')"/></p>
                        <table style="border-collapse: collapse; width: 100%; margin-bottom: 18px;">
                            <thead><tr>
                                <th style="border:1px solid #ddd;padding:6px">Hợp đồng</th>
                                <th style="border:1px solid #ddd;padding:6px">Loại / Trạm</th>
                                <th style="border:1px solid #ddd;padding:6px">Đối tác</th>
                                <th style="border:1px solid #ddd;padding:6px">Hiệu lực / Hết hạn</th>
                                <th style="border:1px solid #ddd;padding:6px">Còn lại</th>
                                <th style="border:1px solid #ddd;padding:6px">Trạng thái</th>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="project.get('contracts') or []" t-as="contract">
                                    <td style="border:1px solid #ddd;padding:6px"><a t-if="contract.get('url')" t-att-href="contract.get('url')"><t t-out="contract.get('code')"/></a><t t-if="not contract.get('url')" t-out="contract.get('code')"/></td>
                                    <td style="border:1px solid #ddd;padding:6px"><t t-out="contract.get('type')"/> / <t t-out="contract.get('station')"/></td>
                                    <td style="border:1px solid #ddd;padding:6px"><t t-out="contract.get('partner')"/></td>
                                    <td style="border:1px solid #ddd;padding:6px"><t t-out="contract.get('start_date')"/> / <t t-out="contract.get('expiration_date')"/></td>
                                    <td style="border:1px solid #ddd;padding:6px"><strong t-if="contract.get('priority')" style="color:#b42318"><t t-out="contract.get('days_left')"/> ngày</strong><t t-if="not contract.get('priority')"><t t-out="contract.get('days_left')"/> ngày</t></td>
                                    <td style="border:1px solid #ddd;padding:6px"><t t-out="contract.get('state')"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <p>Đề nghị Anh/Chị ưu tiên các hợp đồng có số ngày còn lại thấp, mở từng hồ sơ để bắt đầu hoặc tiếp tục quy trình gia hạn.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
