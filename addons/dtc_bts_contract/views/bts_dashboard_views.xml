<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bts_contract_dashboard_form" model="ir.ui.view">
        <field name="name">bts.contract.dashboard.form</field>
        <field name="model">bts.contract.dashboard</field>
        <field name="arch" type="xml">
            <form
                string="Dashboard hợp đồng"
                create="false"
                edit="false"
                delete="false">
                <field name="dashboard_html" nolabel="1" readonly="1"/>
            </form>
        </field>
    </record>

    <record id="action_bts_contract_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Hợp đồng BTS</field>
        <field name="res_model">bts.contract.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bts_contract_dashboard_form"/>
        <field name="res_id" ref="bts_contract_dashboard_main"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

</odoo>
