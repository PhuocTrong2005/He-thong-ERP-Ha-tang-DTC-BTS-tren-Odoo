<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Assign this group only to users who need the original Odoo apps in
        their app switcher. Model permissions are intentionally untouched.
    -->
    <record id="group_show_core_apps" model="res.groups">
        <field name="name">Hiển thị phân hệ Odoo gốc</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- System Administrators always keep every core application and its
         manager-level access, independently from normal-user visibility. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('dtc_bts_menu_visibility.group_show_core_apps')),
            (4, ref('project.group_project_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('maintenance.group_equipment_manager')),
            (4, ref('account.group_account_manager'))
        ]"/>
    </record>

</odoo>
